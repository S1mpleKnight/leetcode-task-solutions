class Solution171 {
    public int titleToNumber(String columnTitle) {
        int result = 0;
        int counter = 0;
        for (int i = columnTitle.length() - 1; i >= 0; i--) {
            result += (columnTitle.charAt(i) - 'A' + 1) * (int) Math.pow(26, counter);
            counter++;
        }
        return  result;
    }
}
